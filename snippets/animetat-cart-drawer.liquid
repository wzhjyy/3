{% comment %}
  ANIMETAT Custom AJAX Cart Drawer
  Usage: add {% render 'animetat-cart-drawer' %} before </body> in layout/theme.liquid.
{% endcomment %}

<div id="AnimetatCartDrawer" class="animetat-cart-drawer" aria-hidden="true">
  <div class="animetat-cart-overlay" data-cart-close></div>
  <aside class="animetat-cart-panel" role="dialog" aria-modal="true" aria-label="Cart">
    <header class="animetat-cart-header">
      <span class="animetat-cart-bag" aria-hidden="true">▢</span>
      <strong>Cart</strong>
      <button class="animetat-cart-close" type="button" data-cart-close aria-label="Close cart">×</button>
    </header>

    <div class="animetat-cart-progress">
      <p class="animetat-cart-progress-text" data-progress-text>🔥 You're 1 tattoo away from 10% off 🔥</p>
      <div class="animetat-progress-line"><span data-progress-fill></span></div>
      <div class="animetat-progress-steps" aria-hidden="true">
        <span><b>🚚</b><small>FREE<br>SHIPPING</small></span>
        <span><b>%</b><small>SAVE<br>10%</small></span>
        <span><b>%</b><small>SAVE<br>15%</small></span>
        <span><b>%</b><small>SAVE<br>20%</small></span>
      </div>
    </div>

    <section class="animetat-cart-items-wrap">
      <div class="animetat-cart-count-row">
        <strong><span data-cart-count>0</span> Products</strong>
        <button type="button" data-clear-cart>Clear All</button>
      </div>
      <div class="animetat-cart-items" data-cart-items></div>
      <div class="animetat-cart-empty" data-cart-empty>Your cart is empty.</div>
    </section>

    <footer class="animetat-cart-footer">
      <div class="animetat-subtotal-row">
        <strong>SUBTOTAL</strong>
        <div><strong data-cart-subtotal>$0.00</strong></div>
      </div>
      <form class="animetat-discount-row" data-discount-form>
        <input type="text" name="discount" placeholder="Discount code" autocomplete="off">
        <button type="submit">Apply</button>
      </form>
      <button class="animetat-checkout-btn" type="button" data-checkout>Checkout</button>
      <button class="animetat-continue-btn" type="button" data-cart-close>Continue Shopping</button>
    </footer>
  </aside>
</div>

<style>
  .animetat-cart-drawer{position:fixed;inset:0;z-index:2147483000;pointer-events:none;visibility:hidden}
  .animetat-cart-drawer.is-open{pointer-events:auto;visibility:visible}
  .animetat-cart-overlay{position:absolute;inset:0;background:rgba(0,0,0,.48);opacity:0;transition:opacity .22s ease}
  .animetat-cart-drawer.is-open .animetat-cart-overlay{opacity:1}
  .animetat-cart-panel{position:absolute;top:0;right:0;width:min(420px,100vw);height:100dvh;background:#fff;transform:translateX(105%);transition:transform .26s ease;display:flex;flex-direction:column;box-shadow:-8px 0 24px rgba(0,0,0,.16);font-family:inherit;color:#000}
  .animetat-cart-drawer.is-open .animetat-cart-panel{transform:translateX(0)}
  body.animetat-cart-is-open{overflow:hidden!important;touch-action:none}
  .animetat-cart-header{height:58px;display:grid;grid-template-columns:34px 1fr 34px;align-items:center;padding:0 18px;border-bottom:1px solid #eee;font-size:18px;text-align:center}
  .animetat-cart-bag{font-size:20px;text-align:left}.animetat-cart-close{border:0;background:transparent;font-size:32px;line-height:1;cursor:pointer;color:#111}
  .animetat-cart-progress{padding:14px 18px 18px;border-bottom:1px solid #eee;text-align:center}.animetat-cart-progress-text{margin:0 0 12px;font-weight:800;font-size:14px}
  .animetat-progress-line{height:7px;background:#e8e8e8;border-radius:999px;position:relative;overflow:hidden}.animetat-progress-line span{display:block;height:100%;width:0;background:#000;border-radius:999px;transition:width .2s ease}
  .animetat-progress-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px}.animetat-progress-steps span{display:flex;flex-direction:column;align-items:center;gap:3px}.animetat-progress-steps b{display:grid;place-items:center;width:25px;height:25px;border:2px solid #111;border-radius:50%;font-size:11px;background:#fff}.animetat-progress-steps small{font-weight:800;font-size:9px;line-height:1.05}
  .animetat-cart-items-wrap{flex:1;overflow:auto;padding:18px}.animetat-cart-count-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.animetat-cart-count-row button{border:0;border-radius:999px;background:#f2f2f2;padding:7px 10px;font-size:12px;cursor:pointer}
  .animetat-cart-items{display:flex;flex-direction:column;gap:12px}.animetat-cart-item{display:grid;grid-template-columns:64px 1fr 24px;gap:12px;border:1px solid #e6e6e6;border-radius:8px;padding:12px;background:#fff}.animetat-cart-item img{width:64px;height:84px;object-fit:cover;border-radius:2px;background:#f5f5f5}.animetat-cart-item-title{font-weight:800;font-size:13px;line-height:1.25;margin:0 0 7px}.animetat-cart-item-price{color:#e00000;font-weight:800;font-size:12px;margin-bottom:9px}.animetat-cart-item-bottom{display:flex;justify-content:space-between;gap:10px;align-items:center}.animetat-qty{display:grid;grid-template-columns:28px 32px 28px;border:1px solid #e1e1e1;border-radius:4px;overflow:hidden;height:28px}.animetat-qty button{border:0;background:#f7f7f7;cursor:pointer}.animetat-qty span{display:grid;place-items:center;font-weight:700}.animetat-line-price{color:#e00000;font-weight:800;font-size:13px}.animetat-remove{border:0;background:transparent;font-size:18px;cursor:pointer;color:#111;padding:0}.animetat-cart-empty{display:none;text-align:center;padding:48px 10px;color:#555}.animetat-cart-empty.is-visible{display:block}
  .animetat-cart-footer{border-top:1px solid #eee;padding:14px 18px 18px;background:#fff}.animetat-subtotal-row{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:9px}.animetat-discount-row{display:grid;grid-template-columns:1fr 64px;gap:8px;margin-bottom:12px}.animetat-discount-row input{height:42px;border:1px solid #ddd;padding:0 12px;font-size:14px}.animetat-discount-row button,.animetat-checkout-btn{height:42px;border:0;border-radius:3px;background:#000;color:#fff;font-weight:800;cursor:pointer}.animetat-checkout-btn{width:100%;font-size:15px;margin-bottom:8px}.animetat-continue-btn{display:block;margin:0 auto;border:0;background:transparent;text-decoration:underline;cursor:pointer;color:#111;font-size:13px}
  @media(max-width:600px){.animetat-cart-panel{width:100vw}.animetat-cart-header{height:54px}.animetat-cart-items-wrap{padding:14px}.animetat-cart-footer{padding:12px 14px 16px}}
</style>

<script>
(function(){
  if(window.__AnimetatCartDrawerLoaded) return; window.__AnimetatCartDrawerLoaded = true;
  const drawer = document.getElementById('AnimetatCartDrawer');
  if(!drawer) return;
  const itemsEl = drawer.querySelector('[data-cart-items]');
  const countEl = drawer.querySelector('[data-cart-count]');
  const subtotalEl = drawer.querySelector('[data-cart-subtotal]');
  const emptyEl = drawer.querySelector('[data-cart-empty]');
  const progressText = drawer.querySelector('[data-progress-text]');
  const progressFill = drawer.querySelector('[data-progress-fill]');
  const moneyFormat = {{ shop.money_format | json }};
  let currentDiscount = '';

  function formatMoney(cents){
    if(window.Shopify && Shopify.formatMoney) return Shopify.formatMoney(cents, moneyFormat);
    return '$' + (cents / 100).toFixed(2);
  }
  function openCart(){ drawer.classList.add('is-open'); drawer.setAttribute('aria-hidden','false'); document.body.classList.add('animetat-cart-is-open'); refreshCart(); }
  function closeCart(){ drawer.classList.remove('is-open'); drawer.setAttribute('aria-hidden','true'); document.body.classList.remove('animetat-cart-is-open'); }
  function updateProgress(cart){
    const count = cart.item_count || 0;
    const next = count < 2 ? 2 - count : count < 3 ? 3 - count : count < 4 ? 4 - count : 0;
    const pct = Math.min(100, count / 4 * 100);
    progressFill.style.width = pct + '%';
    if(count >= 4) progressText.textContent = '🔥 You unlocked the best offer 🔥';
    else if(count >= 3) progressText.textContent = "🔥 You're 1 tattoo away from 20% off 🔥";
    else if(count >= 2) progressText.textContent = "🔥 You're 1 tattoo away from 15% off 🔥";
    else progressText.textContent = "🔥 You're " + next + " tattoo away from 10% off 🔥";
  }
  function renderCart(cart){
    countEl.textContent = cart.item_count || 0;
    subtotalEl.textContent = formatMoney(cart.total_price || 0);
    updateProgress(cart);
    itemsEl.innerHTML = '';
    emptyEl.classList.toggle('is-visible', !cart.items || !cart.items.length);
    (cart.items || []).forEach(function(item, index){
      const img = item.image ? '<img src="' + item.image + '&width=160" alt="' + escapeHtml(item.product_title || item.title) + '">' : '<div></div>';
      const line = document.createElement('div');
      line.className = 'animetat-cart-item';
      line.innerHTML = img + '<div><p class="animetat-cart-item-title">' + escapeHtml(item.product_title || item.title) + '</p><div class="animetat-cart-item-price">' + formatMoney(item.final_price) + '</div><div class="animetat-cart-item-bottom"><div class="animetat-qty"><button type="button" data-qty="' + (item.quantity - 1) + '" data-line="' + (index + 1) + '">−</button><span>' + item.quantity + '</span><button type="button" data-qty="' + (item.quantity + 1) + '" data-line="' + (index + 1) + '">+</button></div><strong class="animetat-line-price">' + formatMoney(item.final_line_price) + '</strong></div></div><button class="animetat-remove" type="button" data-qty="0" data-line="' + (index + 1) + '" aria-label="Remove">⌫</button>';
      itemsEl.appendChild(line);
    });
    document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
  }
  function escapeHtml(str){ return String(str || '').replace(/[&<>"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]; }); }
  function getCart(){ return fetch('/cart.js', {credentials:'same-origin', headers:{'Accept':'application/json'}}).then(r=>r.json()); }
  function refreshCart(){ return getCart().then(renderCart); }
  function changeLine(line, qty){ return fetch('/cart/change.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({line:Number(line),quantity:Number(qty)})}).then(r=>r.json()).then(renderCart); }
  function addForm(form){ return fetch('/cart/add.js',{method:'POST',credentials:'same-origin',headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'},body:new FormData(form)}).then(function(r){ if(!r.ok) throw new Error('add failed'); return r.json(); }).then(function(){ return refreshCart().then(openCart); }); }

  document.addEventListener('submit', function(e){
    const form = e.target;
    if(form && form.matches('form[action^="/cart/add"]')){ e.preventDefault(); e.stopPropagation(); addForm(form).catch(function(){ form.submit(); }); }
  }, true);
  document.addEventListener('click', function(e){
    const close = e.target.closest('[data-cart-close]'); if(close){ e.preventDefault(); closeCart(); return; }
    const cartLink = e.target.closest('a[href="/cart"], a[href^="/cart?"]'); if(cartLink){ e.preventDefault(); e.stopPropagation(); openCart(); return; }
    const addBtn = e.target.closest('form[action^="/cart/add"] button, form[action^="/cart/add"] input[type="submit"], .btn--add-to-cart');
    if(addBtn){ const form = addBtn.closest('form[action^="/cart/add"]'); if(form){ e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation(); addForm(form).catch(function(){ form.submit(); }); } return; }
    const qty = e.target.closest('[data-line][data-qty]'); if(qty){ e.preventDefault(); changeLine(qty.dataset.line, qty.dataset.qty); return; }
    if(e.target.closest('[data-clear-cart]')){ e.preventDefault(); fetch('/cart/clear.js',{method:'POST',credentials:'same-origin'}).then(r=>r.json()).then(renderCart); return; }
    if(e.target.closest('[data-checkout]')){ e.preventDefault(); window.location.href = currentDiscount ? '/discount/' + encodeURIComponent(currentDiscount) + '?redirect=/checkout' : '/checkout'; }
  }, true);
  const discountForm = drawer.querySelector('[data-discount-form]');
  discountForm.addEventListener('submit', function(e){ e.preventDefault(); currentDiscount = (discountForm.discount.value || '').trim(); if(currentDiscount) discountForm.querySelector('button').textContent = 'Applied'; });
  window.AnimetatCartDrawer = { open: openCart, close: closeCart, refresh: refreshCart };
  refreshCart();
})();
</script>
